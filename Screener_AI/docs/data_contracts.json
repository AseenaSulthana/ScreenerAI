{
  "version": "1.0.0",
  "description": "Data contracts and schemas for AI Talent Scouting & Engagement Agent",
  "timestamp": "2025-04-25T00:00:00Z",
  
  "candidate_schema": {
    "type": "object",
    "description": "Normalized candidate profile structure",
    "required": ["candidate_id", "name", "email"],
    "properties": {
      "candidate_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{8,}$",
        "description": "Unique candidate identifier (auto-generated or from source)"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 255,
        "description": "Full name of candidate"
      },
      "email": {
        "type": "string",
        "format": "email",
        "description": "Primary contact email"
      },
      "phone": {
        "type": "string",
        "pattern": "^[+]?[0-9\\-()\\s]{10,}$",
        "description": "Phone number (optional, normalized format)"
      },
      "resume_text": {
        "type": "string",
        "description": "Full extracted resume text (from PDF or document)"
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of extracted technical skills"
      },
      "years_experience": {
        "type": "number",
        "minimum": 0,
        "maximum": 70,
        "description": "Years of professional experience (inferred)"
      },
      "current_title": {
        "type": "string",
        "description": "Current or most recent job title"
      },
      "current_company": {
        "type": "string",
        "description": "Current or most recent employer"
      },
      "location": {
        "type": "string",
        "description": "Current location (city, state or country)"
      },
      "resume_drive_file_id": {
        "type": "string",
        "description": "Google Drive file ID for original resume PDF"
      },
      "source": {
        "type": "string",
        "enum": ["drive", "sheets", "api"],
        "description": "Data source (Drive folder, Sheets registry, or external API)"
      },
      "last_contacted_at": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 timestamp of last contact"
      },
      "last_interest_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "description": "Last computed Interest Score (if previously engaged)"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "When record was first indexed"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "description": "When record was last updated"
      }
    }
  },

  "job_description_schema": {
    "type": "object",
    "description": "Job description structure for matching",
    "required": ["job_id", "title", "jd_text"],
    "properties": {
      "job_id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{5,}$",
        "description": "Unique job identifier"
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 255,
        "description": "Job title"
      },
      "jd_text": {
        "type": "string",
        "minLength": 50,
        "description": "Full job description text"
      },
      "must_have_skills": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Required technical skills"
      },
      "nice_to_have_skills": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Preferred but not required skills"
      },
      "location": {
        "type": "string",
        "description": "Job location or 'Remote'"
      },
      "min_years_experience": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50,
        "description": "Minimum years of experience required"
      },
      "seniority_level": {
        "type": "string",
        "enum": ["entry", "mid", "senior", "principal", "lead"],
        "description": "Experience level required"
      },
      "department": {
        "type": "string",
        "description": "Department or team"
      },
      "shortlist_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 10,
        "description": "Number of top candidates to return"
      },
      "outreach_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable simulated outreach for Interest Score"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "When this JD was posted"
      }
    }
  },

