  "scoring_rubric": {
    "match_score": {
      "description": "Technical fit based on skills, experience, domain, and seniority",
      "formula": "0.40*skills + 0.25*experience + 0.20*domain + 0.15*seniority",
      "components": {
        "skills_40_percent": {
          "description": "Overlap between candidate skills and job requirements",
          "hard_match": "Required skill explicitly listed in CV → 100 points",
          "partial_match": "Similar/adjacent skill (e.g., PostgreSQL vs MySQL) → 70 points",
          "missing": "Required skill not found → 0 points",
          "formula": "(matched + partial*0.7) / total_required * 100"
        },
        "experience_25_percent": {
          "description": "Alignment between candidate background and job requirements",
          "years_in_role": "candidate_years / min_required (capped at 1.0 if exceeds)",
          "relevant_domain": "CV mentions target industry/domain → +15 bonus",
          "formula": "(years_score*100) + domain_bonus"
        },
        "domain_20_percent": {
          "description": "Domain-specific knowledge and terminology match",
          "key_terms": "E.g., 'distributed systems', 'microservices', 'high-scale'",
          "score_by_term_frequency": "Keyword frequency in CV vs JD",
          "formula": "matched_domain_terms / total_domain_terms * 100"
        },
        "seniority_15_percent": {
          "description": "Role level alignment",
          "exact_match": "Candidate seniority level = JD level → 100",
          "one_level_up": "Candidate is one level above requirement → 90",
          "one_level_below": "Candidate is one level below requirement → 60",
          "way_below": "Significant gap → 20",
          "formula": "See mapping table"
        }
      }
    },
    "interest_score": {
      "description": "Engagement and genuine interest signals from simulated outreach",
      "formula": "0.35*intent + 0.25*availability + 0.20*compensation + 0.20*depth",
      "components": {
        "intent_enthusiasm_35_percent": {
          "positive_indicators": ["interested", "excited", "definitely", "100%", "absolutely"],
          "negative_indicators": ["maybe", "not sure", "low priority", "not interested"],
          "question_count": "More questions = higher engagement",
          "scoring": "High confidence (0.9+) if multiple positive signals; reduce if mixed/negative"
        },
        "availability_25_percent": {
          "explicit_timeline": "Available in N weeks → high confidence",
          "vague_responses": "TBD, TBH → reduced confidence",
          "current_employment": "Status mention affects availability assessment",
          "scoring": "0–100 based on timeline clarity and flexibility"
        },
        "compensation_location_20_percent": {
          "location_fit": "Candidate OK with location or expresses flexibility → +25 points",
          "compensation_alignment": "Salary range mentioned or implied fit → +25 points",
          "scoring": "0–100 based on level of fit/flexibility"
        },
        "engagement_depth_20_percent": {
          "response_quality": "Specific, thoughtful responses → high score",
          "clarifying_questions": "Asks about role details, team, product → +points",
          "domain_knowledge": "Mentions concrete examples or relevant experience → +points",
          "scoring": "0–100 based on quality and depth of conversation"
        }
      }
    },
    "composite_score": {
      "description": "Final ranking signal combining both dimensions",
      "formula": "0.70*match_score + 0.30*interest_score",
      "rationale": "Match score drives initial filtering; interest score breaks ties and prevents 'perfect on paper, not interested' false positives",
      "tie_breakers": [
        "1. Higher composite_score",
        "2. Higher match_score (if composite tie)",
        "3. Higher interest_score (if match tie)",
        "4. More years_experience (if all tie)"
      ]
    }
  },

  "validation_rules": {
    "job_description": [
      "job_id must be unique (check against Sheets history)",
      "title must be non-empty and >= 3 chars",
      "jd_text OR jd_drive_file_id must be provided (but not both empty)",
      "If jd_text provided, must be >= 50 characters",
      "must_have_skills array must not be empty",
      "must_have_skills must contain string items only",
      "min_years_experience >= 0 and <= 50",
      "shortlist_size default to 10 if missing"
    ],
    "candidate": [
      "candidate_id must be unique",
      "name must be non-empty and >= 2 chars",
      "email must be valid email format (if provided)",
      "phone (if provided) must be valid phone format",
      "years_experience >= 0 and <= 70",
      "resume_drive_file_id must be valid Drive file ID format (if provided)",
      "source must be one of: drive, sheets, api"
    ],
    "outreach_message": [
      "conversation_id must match pattern conv-*",
      "candidate_id must be non-empty",
      "job_id must be non-empty",
      "message must be non-empty and >= 10 characters",
      "timestamp must be valid ISO 8601 format"
    ]
  },

  "error_codes": {
    "validation_failed": {
      "http_code": 400,
      "description": "Input validation failed",
      "examples": ["job_id missing", "must_have_skills empty", "invalid email format"]
    },
    "duplicate_request": {
      "http_code": 409,
      "description": "Duplicate job_id or request_id detected (idempotency guard)",
      "examples": ["job_id already submitted within last 1 hour"]
    },
    "not_found": {
      "http_code": 404,
      "description": "Resource not found",
      "examples": ["job_id not found in status check", "conversation_id not found"]
    },
    "gemini_api_error": {
      "http_code": 503,
      "description": "Gemini API call failed",
      "retry": "Yes, with exponential backoff",
      "examples": ["Quota exceeded", "Service temporarily unavailable"]
    },
    "drive_error": {
      "http_code": 500,
      "description": "Google Drive operation failed",
      "retry": "Yes, with exponential backoff",
      "examples": ["File not found", "Access denied"]
    },
    "sheets_error": {
      "http_code": 500,
      "description": "Google Sheets operation failed",
      "retry": "Yes, with exponential backoff",
      "examples": ["Quota exceeded", "Invalid sheet ID"]
    },
    "internal_error": {
      "http_code": 500,
      "description": "Unexpected internal error",
      "retry": "Yes, check logs and request_id",
      "examples": ["Unhandled exception in workflow"]
    }
  }
}
